<div class="login-wrapper">
    <h1 class="login-title"><%= title %></h1>

    <%- messages() %>

    <% if (errors) { %>
      <ul class="notice-error">
     <% errors.array().forEach(error => { %>
       <li><%= error.msg %></li>
    <%  }) %>
     </ul>
    <% } %>

    <div class="management-wrapper">
        <h2 class="login-title">Welcome <%= locals.accountData.account_firstname %></h2>
        <p><a href="/account/update/<%= locals.accountData.account_id %>" class="update-button">Update Account Information</a></p>
        <% if (locals.accountData.account_type === 'Employee' || locals.accountData.account_type === 'Admin') { %>
            <div class="manage-inventory admin">
                <h3 class="manage-inventory-title">Inventory Management</h3>
                <p class="manage-inventory-text">You have administrative privileges to manage the inventory.</p>
                <p><a href="/inv/" class="management-link">Manage Inventory</a></p>
            </div>
        <% } %>
    </div>

    <div class="my-garage">
        <h3 class="my-garage-title">My Garage (<%= favorites ? favorites.length : 0 %>)</h3>
        
        <% if (favorites && favorites.length > 0) { %>
            <ul id="favorite-cards">
                <% favorites.forEach(fav => { %>
                    <li class="favorite-card">
                        <a class="fav-image-container" href="/inv/detail/<%= fav.inv_id %>">
                            <img class="favorite-image" src="<%= fav.inv_thumbnail %>" alt="<%= fav.inv_make %> <%= fav.inv_model %>">
                        </a>
                        <h4 class="favorite-name"><%= fav.inv_make %> <%= fav.inv_model %></h4>
                        
                        <form action="/account/remove-favorite" method="POST">
                            <input type="hidden" name="inv_id" value="<%= fav.inv_id %>">
                            <button class="remove-button" type="submit">
                                Remove
                            </button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>Your garage is currently empty. Go browse our inventory to save your dream cars!</p>
        <% } %>
    </div>
</div>