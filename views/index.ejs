<section class="upgrades">
    <div class="upgrades-left">
        <h2 class="upgrades-title">Delorean Upgrades</h2>
        <p class="upgrades-desc">Lorem ipsum dolor sit amet consectetur adipisicing elit. Tenetur, omnis..</p>
    </div>
    <div class="upgrades-right">
