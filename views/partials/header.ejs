<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page" class="site-name">CSE Motors</a>
  </span>
  <div id="tools">
    <% if (locals.loggedin) { %>
      <a href="/account/" class="welcome-message"> Welcome <%= locals.accountData.account_firstname %></a>
      <a title="Click to log out" href="/account/logout" class="login-button">Logout</a>
    <% } else { %>
      <a title="Click to log in" href="/account/login" class="login-button">My Account</a>
    <% } %>
  </div>
</header>